# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vacation_planner?schema=public"

# Auth.js secret, generate with: npx auth secret
AUTH_SECRET=""

# Resend API key for magic-link emails. Leave empty in development:
# the sign-in link is then printed to the server console instead.
AUTH_RESEND_KEY=""
EMAIL_FROM="Vacation Planner <onboarding@resend.dev>"

# Public URL in production, used for links in emails:
# AUTH_URL="https://vacations.example.com"

# Protects the daily Teams digest endpoint; Vercel Cron sends it automatically.
CRON_SECRET=""
