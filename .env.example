# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vacation_planner?schema=public"

# Auth.js secret, generate with: npx auth secret
AUTH_SECRET=""

# Resend API key for magic-link emails. Leave empty in development:
# the sign-in link is then printed to the server console instead.
AUTH_RESEND_KEY=""
EMAIL_FROM="Vacation Planner <onboarding@resend.dev>"

# Public URL in production, used for links in emails:
# AUTH_URL="https://vacations.example.com"

# Emails of the operator's team who may open /admin (comma separated). They sign in with a normal email link.
# SUPERADMIN_EMAILS="you@example.com, colleague@example.com"

# Protects the daily Teams digest endpoint; Vercel Cron sends it automatically.
CRON_SECRET=""

# Free beta (default on). Set to "false" for the paid phase. NEXT_PUBLIC_ variables are baked in at build time: redeploy after changing.
# NEXT_PUBLIC_ENABLE_BETA_MODE="true"

# Error monitoring (Sentry, EU region). Empty = off. The DSN is not a secret.
NEXT_PUBLIC_SENTRY_DSN=""
# Source maps uploaded at build time so errors point at the real line. Set these in Vercel only; SENTRY_AUTH_TOKEN is secret.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Usage statistics (PostHog, EU cloud, cookieless). Empty key = off. The key is not a secret.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# Session replay of the public pages only; "false" turns it off.
# NEXT_PUBLIC_POSTHOG_REPLAY="true"
