generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (do not rename fields, the adapter relies on them) ----------

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  // "en" or "de"; null follows the browser language.
  locale          String?
  // Second factor for the operator's team (src/lib/totp.ts). The secret is stored encrypted and counts only once totpEnabledAt is set.
  totpSecret      String?
  totpEnabledAt   DateTime?
  // The last 30-second step a code was accepted for, so a code can't be used twice.
  totpLastStep    Int?
  totpFailedCount Int       @default(0)
  totpLockedUntil DateTime?
  // SHA-256 hashes of the unused one-time recovery codes.
  recoveryHashes  String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  createdWorkspaces Workspace[]  @relation("WorkspaceCreator")
  sentInvitations   Invitation[] @relation("InvitationSender")
  createdBookings   Booking[]    @relation("BookingCreator")
  decidedBookings   Booking[]    @relation("BookingDecider")
  auditEvents       AuditEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken        String    @unique
  userId              String
  expires             DateTime
  // When this sign-in passed the second factor; operators need it for /admin (src/lib/two-factor.ts).
  twoFactorVerifiedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Domain ----------

// ADMIN runs the workspace, APPROVER decides requests and books for others, MEMBER books their own, VIEWER only looks (#77).
enum Role {
  ADMIN
  APPROVER
  MEMBER
  VIEWER
}

enum Plan {
  FREE
  TEAM
  BUSINESS
}

model Workspace {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  // IANA timezone used for date math, e.g. "Europe/Sarajevo".
  timezone           String    @default("UTC")
  // Null once the creator deleted their account.
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  // Set when an admin deletes the workspace. It is hidden and can be restored for RESTORE_DAYS; the monthly purge then deletes it for good.
  deletedAt          DateTime?
  // While in the future, the operator's team may look at this workspace's members for support. Set by a workspace admin, 24 hours at a time.
  supportAccessUntil DateTime?
  // Created during the free beta: keeps the founder discount (FOUNDER_DISCOUNT_PERCENT) when it subscribes, see createCheckout.
  founderRate        Boolean   @default(false)

  // Billing. Everything is unlocked until trialEndsAt; after that the paid plan applies while Stripe says it's active.
  plan                 Plan      @default(FREE)
  trialEndsAt          DateTime?
  // Stripe subscription status, e.g. "active", "past_due", "canceled".
  billingStatus        String?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  // When the subscription stops after a cancel in the portal; null while it renews.
  cancelAt             DateTime?
  // When the "trial ends in 7 days" and "ends tomorrow" emails went to the admins, so each goes out once.
  trialReminder7SentAt DateTime?
  trialReminder1SentAt DateTime?

  createdBy   User?              @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  settings    WorkspaceSettings?
  memberships Membership[]
  invitations Invitation[]
  bookings    Booking[]
  holidays    Holiday[]
  leaveTypes  LeaveType[]
  auditEvents AuditEvent[]
  coldMails   ColdMail[]
}

// Days off for everyone; they don't count against allowances.
model Holiday {
  id          String   @id @default(cuid())
  workspaceId String
  date        DateTime @db.Date
  // In the country's language, e.g. "Tag der Deutschen Einheit".
  name        String
  // The English name from the holiday import, shown to people using the app in English; null for holidays added by hand.
  englishName String?
  // ISO 3166-2 region the holiday applies to, e.g. "DE-BE"; empty for everyone in the workspace.
  region      String   @default("")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, region])
}

// Per-workspace feature flags.
model WorkspaceSettings {
  workspaceId           String    @id
  approvalsEnabled      Boolean   @default(false)
  countWeekends         Boolean   @default(false)
  allowHalfDays         Boolean   @default(true)
  // Yearly allowance given to new members; null means allowances are not tracked by default.
  defaultAllowanceDays  Decimal?  @default(20) @db.Decimal(4, 1)
  // Most unused vacation days that roll into the next year; null or 0 means none.
  maxCarryOverDays      Decimal?  @db.Decimal(4, 1)
  // "MM-DD" by which carried-over days must be taken, e.g. "03-31"; null means they never expire.
  carryOverExpiry       String?
  // Warn when fewer people than this would be working on a day; null turns the check off.
  minPeoplePresent      Int?
  // Pending requests (#80): remind the approvers once after this many days (null: never), and approve
  // automatically after this many days if nobody answered (null: never, the default).
  reminderDays          Int?      @default(3)
  autoApproveDays       Int?
  // ISO 3166 country code last used to import public holidays, e.g. "BA".
  holidayCountry        String?
  // Default ISO 3166-2 region for members' regional holidays, e.g. "DE-BE"; null means nationwide only.
  holidayRegion         String?
  // When the holidays cron last refreshed this workspace's holidays; null means never.
  holidaysRefreshedAt   DateTime?
  // Microsoft Teams webhook (Workflows or connector) for booking notifications.
  teamsWebhookUrl       String?
  // Colleagues see sick leave as "Other" without its note; admins and the person still see it as sick.
  hideSickType          Boolean   @default(true)
  // Slack incoming webhook, posted to alongside Teams.
  slackWebhookUrl       String?
  /// Last failed post per channel ("404", "network"), cleared by the next post that arrives; shown in Settings.
  teamsError            String?
  teamsErrorAt          DateTime?
  slackError            String?
  slackErrorAt          DateTime?
  // Language of Teams/Slack posts and of emails to people who haven't picked one: "en" or "de".
  locale                String    @default("en")
  // Set when an admin hides the getting-started checklist.
  onboardingDismissedAt DateTime?
  // Kind of team picked at setup (keys of TEAM_TYPES in src/lib/team-types.ts); null for older workspaces.
  teamType              String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Membership {
  id                  String    @id @default(cuid())
  workspaceId         String
  userId              String
  role                Role      @default(MEMBER)
  // Days per calendar year; null means the allowance is not tracked for this member.
  annualAllowanceDays Decimal?  @db.Decimal(4, 1)
  joinedAt            DateTime  @default(now())
  // Soft removal keeps booking history intact.
  removedAt           DateTime?
  // Secret for the personal iCal feed URL; null until the member turns the feed on.
  calendarToken       String?   @unique
  // Where this member works, for regional holidays, e.g. "DE-NW"; null uses the workspace default.
  holidayRegion       String?
  // ISO weekdays this member works (1 = Monday ... 7 = Sunday); empty means the workspace default.
  workDays            Int[]     @default([])
  // First day of employment; the allowance in that year is pro-rated. Null means no pro-rating.
  employmentStart     DateTime? @db.Date
  // A made-up person from "Fill with a sample team": never emailed, can't sign in, not counted toward the plan.
  isSample            Boolean   @default(false)
  // An admin or approver who is away until this day (inclusive): new requests and reminders go to the others (#80).
  awayUntil           DateTime? @db.Date

  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  // Bookings where this person covers for a colleague (#34).
  standingIn     Booking[]         @relation("StandIn")
  pastAllowances AllowanceYear[]
  carriedOver    CarriedOver[]
  keepCarried    KeepCarriedOver[]
  invitations    Invitation[]

  @@unique([workspaceId, userId])
}

// The allowance a member had in a past year, kept when an admin changes it so last year's carry-over stays the same.
// Years without a row use the member's current annualAllowanceDays.
model AllowanceYear {
  membershipId String
  year         Int
  // Null means the allowance wasn't tracked that year.
  days         Decimal? @db.Decimal(4, 1)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, year])
}

// Days someone brought into a year from the time before the app (e.g. "Resturlaub" from Excel), entered by an admin.
// Replaces the carry-over calculated from bookings for that year; the workspace's expiry deadline still applies.
model CarriedOver {
  membershipId String
  // The year the days are carried into.
  year         Int
  days         Decimal @db.Decimal(4, 1)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, year])
}

// Carried-over days that don't expire on the workspace's deadline in this year, for one person: after long
// illness, maternity or parental leave the law keeps them (up to 15 months after the year). No reason is stored.
model KeepCarriedOver {
  membershipId String
  // The year the days were carried into.
  year         Int

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, year])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(MEMBER)
  // Only the hash is stored; the raw token is emailed.
  tokenHash   String    @unique
  // Null once the sender deleted their account.
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  // Someone added without email whose address belongs to an existing account: accepting moves this
  // placeholder membership, with its bookings, onto that account. Null for a plain invitation.
  membershipId String?

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?       @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
}

enum DayPart {
  FULL
  AM
  PM
}

enum BookingType {
  VACATION
  SICK
  // Sonderurlaub: paid leave for a wedding, a birth, a death in the family or a move; doesn't count as vacation.
  SPECIAL
  OTHER
}

// Why someone takes special leave, picked from a list (no free text). Only the person and admins see it.
enum SpecialReason {
  WEDDING
  BIRTH
  BEREAVEMENT
  MOVING
  OTHER
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Booking {
  id            String         @id @default(cuid())
  workspaceId   String
  membershipId  String
  startDate     DateTime       @db.Date
  // Inclusive.
  endDate       DateTime       @db.Date
  // FULL or PM (starts after lunch).
  startPart     DayPart        @default(FULL)
  // FULL or AM (ends at lunch).
  endPart       DayPart        @default(FULL)
  type          BookingType    @default(VACATION)
  // Only for SPECIAL, and optional.
  specialReason SpecialReason?
  // An admin-defined type (#34), shown instead of the built-in name. `type` is then VACATION when the leave type counts
  // as vacation and OTHER otherwise, so allowance, approvals and sick-day privacy work as before.
  leaveTypeId   String?
  note          String?
  // Who covers while the person is away (Vertretung, #34): a colleague from the same workspace, optional.
  standInId     String?
  status        BookingStatus
  daysCount     Decimal        @db.Decimal(4, 1)
  // Null once the creator deleted their account.
  createdById   String?
  decidedById   String?
  decidedAt     DateTime?
  // When it last became pending (made, or changed by the person), and when the approvers were reminded of it (#80).
  pendingSince  DateTime?
  remindedAt    DateTime?
  decisionNote  String?
  // Set when the booking is cancelled, so it can be restored for RESTORE_DAYS: when, what it was before, and "MEMBER_REMOVED"
  // when it was cancelled because the person was removed (it then comes back with them).
  cancelledAt   DateTime?
  cancelledFrom BookingStatus?
  cancelReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  standIn    Membership? @relation("StandIn", fields: [standInId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  decidedBy  User?       @relation("BookingDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  leaveType  LeaveType?  @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startDate])
  @@index([membershipId])
  @@index([standInId])
}

// Leave types an admin adds next to the built-in ones (#34), like Überstundenabbau or Fortbildung. A label to pick, no
// free text on the booking. Archived types stay on their bookings but can't be picked any more.
model LeaveType {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String
  // A key of LEAVE_COLORS in src/components/badges.tsx.
  color            String
  // Taken from the vacation allowance, like vacation.
  countsAsVacation Boolean   @default(false)
  // Its own days per year, for types that don't count as vacation; null means no limit.
  allowanceDays    Decimal?  @db.Decimal(4, 1)
  // Off: booked straight away even with approvals on.
  needsApproval    Boolean   @default(true)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([workspaceId])
}

// Who did what in a workspace, shown to admins and deleted after AUDIT_RETENTION_MONTHS. No free text, no health data.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  // Null once the person deleted their account.
  actorId     String?
  // e.g. "member.removed", see src/lib/audit.ts.
  action      String
  // The person the action was about, by name or email.
  targetLabel String?
  // Machine-readable extra: "2026-11-02/2026-11-04" for bookings, the new role for role changes.
  detail      String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// One row per email sent to someone who hasn't asked for it: an invitation or a "here is where to sign in" mail from an
// admin. Counted per workspace per day (src/lib/mail-limits.ts) so a new account can't use us to mail strangers. No addresses stored.
model ColdMail {
  id          String   @id @default(cuid())
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// One row per request for a sign-in link (src/lib/sign-in-limit.ts). Address and network are kept only as keyed hashes,
// for two days, to limit how many links one address gets, one network asks for and all of us send.
model SignInAttempt {
  id        String   @id @default(cuid())
  emailHash String
  // Null when the request came without a client address (local development).
  ipHash    String?
  // False when the address already had enough links and none was sent.
  sent      Boolean
  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}
